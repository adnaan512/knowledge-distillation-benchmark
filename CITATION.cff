    title: "Distilling the Knowledge in a Neural Network"
    authors:
      - family-names: Hinton
        given-names: Geoffrey
      - family-names: Vinyals
        given-names: Oriol
      - family-names: Dean
        given-names: Jeff
    year: 2015
